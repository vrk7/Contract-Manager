# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Auth (JWT) ────────────────────────────────────────────────────────────────
# Set a fixed secret in production — if unset a random key is generated on
# startup, which invalidates all tokens on every restart.
JWT_SECRET_KEY=change-me-to-a-random-hex-string
JWT_EXPIRE_MINUTES=1440

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to SQLite locally, Postgres inside Docker (auto-detected via /.dockerenv)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgres+asyncpg://analyzer:analyzer@db:5432/analyzer

# ── RAG / Embeddings ──────────────────────────────────────────────────────────
# VECTOR_BACKEND=chroma   (default) — uses ChromaDB; works with SQLite and Postgres
# VECTOR_BACKEND=pgvector — uses PostgreSQL pgvector; requires Postgres DATABASE_URL
VECTOR_BACKEND=chroma
CHROMA_DIR=./data/chroma
PLAYBOOK_SEED_PATH=./standard_terms_playbook.md

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_STREAM_PER_MINUTE=60

# ── LLM cost tracking (USD per token) ────────────────────────────────────────
COST_PER_INPUT_TOKEN=0.000015
COST_PER_OUTPUT_TOKEN=0.000075

# ── LLM reliability ───────────────────────────────────────────────────────────
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:8000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins; defaults to localhost:5173 in dev,
# required in production alongside PRODUCTION_MODE=true
CORS_ORIGINS=https://yourdomain.com

# ── Production mode ───────────────────────────────────────────────────────────
# Disables allow_credentials CORS header; tightens security defaults
PRODUCTION_MODE=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
DEBUG_MODE=false

# ── Data retention ────────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=90

# ── Pipeline ──────────────────────────────────────────────────────────────────
# Run analysis synchronously instead of as a background task
INLINE_ANALYSIS=false

# ── Tests ─────────────────────────────────────────────────────────────────────
# Set automatically by pytest; enables in-memory mode (no DB / Chroma needed)
BYPASS_DB_FOR_TESTS=false
